<?xml version="1.0" encoding="UTF-8"?>
<!--
  Habilita depuracao remota via Chrome DevTools.
  Abra http://localhost:8088 no Chrome com o painel aberto no Photoshop.
  Util durante o desenvolvimento do viewport WebGL.
-->
<ExtensionList>
  <Extension Id="com.lightref.panel">
    <HostList>
      <Host Name="PHXS" Port="8088" />
      <Host Name="PHSP" Port="8088" />
    </HostList>
  </Extension>
</ExtensionList>
